<%- include('partials/head') %>
  <style>
    .cart-note { border-radius: var(--wts-radius); padding: 0.8rem 1.05rem; font-size: 0.9rem; font-weight: 600; margin-bottom: 1rem; }
    .cart-note.ok { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
    .cart-note.warn { background: #fffbeb; border: 1px solid #fcd34d; color: #92400e; }
    .cart-section { margin-bottom: 1.75rem; }
    .cart-section h2 { font-size: 1.02rem; margin: 0 0 0.7rem; color: var(--wts-text); }
    .cart-line { background: #fff; border: 1px solid var(--wts-border); border-radius: var(--wts-radius); box-shadow: var(--wts-shadow); padding: 1rem 1.15rem; margin-bottom: 0.7rem; display: flex; flex-wrap: wrap; gap: 0.85rem; align-items: center; justify-content: space-between; }
    .cart-line .l-main { flex: 1; min-width: 200px; }
    .cart-line strong { color: var(--wts-text); font-size: 0.98rem; }
    .cart-line .l-meta { color: var(--wts-text-3); font-size: 0.84rem; margin-top: 0.25rem; }
    .cart-line .l-amount { font-weight: 800; color: var(--wts-magenta); white-space: nowrap; font-size: 1.02rem; }
    .cart-line form.inline { display: inline-flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; margin-top: 0.45rem; }
    .cart-line .sub-note { display: block; color: var(--wts-muted); font-size: 0.78rem; margin-top: 0.3rem; }
    .cart-line select, .cart-line input[type=number] { padding: 0.35rem 0.5rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.86rem; font-family: inherit; max-width: 220px; }
    .cart-line input[type=number] { width: 5.2rem; }
    .btn-mini { border: 1px solid var(--wts-border); background: #fff; color: var(--wts-text-2); border-radius: 999px; padding: 0.35rem 0.9rem; font-size: 0.8rem; font-weight: 700; cursor: pointer; font-family: inherit; }
    .btn-mini:hover { border-color: #f9a8d4; color: var(--wts-magenta); }
    .btn-mini.danger:hover { border-color: #fca5a5; color: #b91c1c; }
    .needs-choice { color: #92400e; background: #fffbeb; border: 1px solid #fcd34d; border-radius: 999px; font-size: 0.74rem; font-weight: 700; padding: 0.1rem 0.6rem; }
    .quote-flag { color: #1d4ed8; background: #eff6ff; border-radius: 999px; font-size: 0.74rem; font-weight: 700; padding: 0.1rem 0.6rem; }
    .cart-total { background: #fff; border: 1px solid var(--wts-border); border-radius: var(--wts-radius); box-shadow: var(--wts-shadow); padding: 1.15rem 1.25rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; }
    .cart-total .t-label { color: var(--wts-text-2); font-weight: 700; }
    .cart-total .t-amount { font-size: 1.45rem; font-weight: 800; color: var(--wts-magenta); }
    .btn-pay { background: var(--wts-magenta); color: #fff; border: none; border-radius: 999px; padding: 0.75rem 1.8rem; font-size: 1rem; font-weight: 800; cursor: pointer; font-family: inherit; }
    .btn-pay:hover { background: var(--wts-magenta-dark, #b91c6f); }
    .btn-quote { background: #fff; color: var(--wts-magenta); border: 1.5px solid var(--wts-magenta); border-radius: 999px; padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 800; cursor: pointer; font-family: inherit; }
    .btn-wa { display: inline-flex; align-items: center; gap: 0.45rem; background: #25D366; color: #fff; border-radius: 999px; padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 800; text-decoration: none; }
    .quote-note { width: 100%; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 10px; padding: 0.6rem 0.8rem; font-size: 0.92rem; font-family: inherit; resize: vertical; min-height: 70px; margin: 0.6rem 0; }
    .empty-cart { text-align: center; background: #fff; border: 1px dashed var(--wts-border); border-radius: var(--wts-radius); padding: 2.5rem 1.5rem; color: var(--wts-text-3); }
    .empty-cart a.cta { display: inline-block; margin-top: 0.9rem; background: var(--wts-magenta); color: #fff; border-radius: 999px; padding: 0.6rem 1.4rem; font-weight: 700; text-decoration: none; }
    .hint { color: var(--wts-muted); font-size: 0.82rem; margin-top: 0.5rem; }
    /* Slide-in payment panel — same drawer pattern as the other right-hand
       sidebars; Stripe's embedded checkout mounts inside it. */
    .pay-overlay { position: fixed; inset: 0; background: rgba(15,23,42,0.55); z-index: 60; opacity: 0; visibility: hidden; transition: opacity .25s, visibility .25s; }
    .pay-panel { position: fixed; top: 0; right: 0; height: 100%; width: 100%; max-width: 520px; background: #fff; z-index: 61; transform: translateX(100%); transition: transform .3s ease; display: flex; flex-direction: column; box-shadow: -12px 0 32px rgba(15,23,42,0.18); }
    body.pay-open .pay-overlay { opacity: 1; visibility: visible; }
    body.pay-open .pay-panel { transform: translateX(0); }
    .pay-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--wts-border); }
    .pay-panel-head strong { font-size: 1.02rem; color: var(--wts-text); }
    .pay-panel-close { background: none; border: none; font-size: 1.6rem; line-height: 1; color: var(--wts-text-3); cursor: pointer; padding: 0.25rem 0.55rem; font-family: inherit; }
    .pay-panel-body { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 0.6rem 0.75rem 1.25rem; }
    .pay-panel-status { text-align: center; color: var(--wts-text-3); font-size: 0.9rem; padding: 2.5rem 1rem; }
    .pay-panel-status.error { color: #b91c1c; }
    .pay-panel-status .spin { display: inline-block; width: 26px; height: 26px; border: 3px solid #fbcfe8; border-top-color: var(--wts-magenta); border-radius: 50%; animation: payspin .9s linear infinite; margin-bottom: 0.7rem; }
    .pay-panel-status .err-hint { display: block; margin-top: 0.5rem; font-size: 0.82rem; color: var(--wts-text-3); }
    @keyframes payspin { to { transform: rotate(360deg); } }
  </style>
</head>
<body class="portal-app">
  <%- include('partials/topbar') %>
  <div class="app-shell">
    <%- include('partials/nav', { active: 'cart' }) %>
    <main class="main">
      <div class="main-inner">
        <div class="page-head">
          <p class="page-kicker"><%= t('cart.kicker') %></p>
          <h1><%= t('cart.title') %></h1>
          <p class="page-sub"><%= t('cart.subtitle') %></p>
        </div>

        <% if (notice.quoted) { %><div class="cart-note ok"><%= t('cart.noticeQuoted') %></div><% } %>
        <% if (notice.updated) { %><div class="cart-note ok"><%= t('cart.noticeUpdated') %></div><% } %>
        <% if (notice.removed) { %><div class="cart-note ok"><%= t('cart.noticeRemoved') %></div><% } %>
        <% if (notice.incomplete) { %><div class="cart-note warn"><%= t('cart.noticeIncomplete') %></div><% } %>
        <% if (notice.mixed) { %><div class="cart-note warn"><%= t('cart.noticeMixed') %></div><% } %>
        <% if (notice.mixedcycle) { %><div class="cart-note warn"><%= t('cart.noticeMixedCycle') %></div><% } %>
        <% if (notice.payerr) { %><div class="cart-note warn"><%= t('cart.noticePayError') %></div><% } %>
        <% if (notice.cancelled) { %><div class="cart-note warn"><%= t('cart.noticeCancelled') %></div><% } %>

        <% if (cart.itemCount === 0) { %>
          <div class="empty-cart">
            <p><strong><%= t('cart.emptyTitle') %></strong></p>
            <p><%= t('cart.emptyBody') %></p>
            <a class="cta" href="https://wordsthatsells.website/en/digital-marketing-services/" rel="noopener"><%= t('cart.emptyCta') %></a>
          </div>
        <% } else { %>

          <% if (cart.payable.length) { %>
          <div class="cart-section">
            <h2><%= t('cart.sectionPay') %></h2>
            <% cart.payable.forEach(function (l) { %>
            <div class="cart-line">
              <div class="l-main">
                <strong><%= l.name %></strong>
                <% if (l.needs_choice) { %> <span class="needs-choice"><%= t('cart.chooseOption') %></span><% } %>
                <div class="l-meta">
                  <% if (l.kind === 'subscription') { %>
                    <% if (l.has_both) { %>
                    <form class="inline" method="POST" action="/portal/cart/items/<%= l.product_id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <select name="billing_period">
                        <option value="monthly" <%= l.billing_period === 'monthly' ? 'selected' : '' %>><%= t('cart.monthly') %> · <%= l.monthly_price.toFixed(2) %> <%= l.currency %><%= t('cart.perMonth') %></option>
                        <option value="yearly" <%= l.billing_period === 'yearly' ? 'selected' : '' %>><%= t('cart.yearly') %> · <%= l.yearly_price.toFixed(2) %> <%= l.currency %><%= t('cart.perYear') %></option>
                      </select>
                      <button class="btn-mini" type="submit"><%= t('cart.update') %></button>
                    </form>
                    <% } %>
                    <span class="sub-note"><%= t('cart.renewNote', { amount: l.recurring_price.toFixed(2) + ' ' + l.currency, period: l.interval === 'year' ? t('cart.perYear') : t('cart.perMonth') }) %><%= l.setup_fee > 0 ? ' · ' + (l.setup_fee_label || t('cart.setupFee')) + ' ' + l.setup_fee.toFixed(2) + ' ' + l.currency + ' ' + t('cart.oneTime') : '' %></span>
                  <% } else if (l.kind === 'options') { %>
                    <form class="inline" method="POST" action="/portal/cart/items/<%= l.product_id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <select name="option_key">
                        <% if (l.needs_choice) { %><option value="" selected>— <%= t('cart.chooseOption') %> —</option><% } %>
                        <% l.options.forEach(function (o) { %>
                          <option value="<%= o.key %>" <%= l.option_key === o.key ? 'selected' : '' %>><%= o.label %><%= o.price != null ? ' · ' + o.price.toFixed(2) + ' ' + l.currency : '' %></option>
                        <% }); %>
                      </select>
                      <button class="btn-mini" type="submit"><%= t('cart.update') %></button>
                    </form>
                  <% } else if (l.kind === 'tiered' || l.price_unit === 'hour' || l.price_unit === 'item') { %>
                    <form class="inline" method="POST" action="/portal/cart/items/<%= l.product_id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <label><%= l.price_unit === 'hour' ? t('cart.hours') : t('cart.quantity') %>
                        <input type="number" name="quantity" min="<%= l.min_qty || 1 %>" max="9999" value="<%= l.quantity %>">
                      </label>
                      <button class="btn-mini" type="submit"><%= t('cart.update') %></button>
                      <span><%= l.unit_price.toFixed(2) %> <%= l.currency %><%= l.price_unit === 'hour' ? t('cart.perHour') : (l.kind === 'tiered' ? t('cart.perUnit') : '') %></span>
                    </form>
                  <% } %>
                </div>
              </div>
              <span class="l-amount"><%= l.amount != null ? l.amount.toFixed(2) + ' ' + l.currency : '—' %><% if (l.kind === 'subscription') { %><small style="display:block;font-size:0.68rem;font-weight:600;color:var(--wts-muted);"><%= t('cart.firstPayment') %></small><% } %></span>
              <form method="POST" action="/portal/cart/items/<%= l.product_id %>/remove">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn-mini danger" type="submit"><%= t('cart.remove') %></button>
              </form>
            </div>
            <% }); %>

            <div class="cart-total">
              <span class="t-label"><%= t('cart.totalLabel') %></span>
              <span class="t-amount"><%= cart.total != null ? cart.total.toFixed(2) + ' ' + cart.currency : '—' %></span>
              <form method="POST" action="/portal/cart/checkout" id="cart-pay-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn-pay" type="submit"><%= t('cart.payNow', { amount: cart.total != null ? cart.total.toFixed(2) + ' ' + cart.currency : '' }) %></button>
              </form>
              <% if (cart.recurring && cart.recurring.length) { %>
              <span style="flex-basis:100%;font-size:0.82rem;color:var(--wts-muted);font-weight:600;">
                <%= t('cart.thenRecurring', { summary: cart.recurring.map(function (r) { return r.sum.toFixed(2) + ' ' + cart.currency + (r.interval === 'year' ? t('cart.perYear') : t('cart.perMonth')); }).join(' · ') }) %>
              </span>
              <% } %>
            </div>
            <p class="hint"><%= t('cart.payHint') %></p>
          </div>

          <div class="pay-overlay" id="pay-overlay"></div>
          <aside class="pay-panel" id="pay-panel" role="dialog" aria-modal="true" aria-label="<%= t('cart.payPanelTitle') %>" hidden>
            <div class="pay-panel-head">
              <strong><%= t('cart.payPanelTitle') %></strong>
              <button type="button" class="pay-panel-close" id="pay-panel-close" aria-label="<%= t('cart.payPanelClose') %>">&times;</button>
            </div>
            <div class="pay-panel-body">
              <div class="pay-panel-status" id="pay-panel-status">
                <span class="spin" id="pay-panel-spin"></span>
                <div id="pay-panel-msg"><%= t('cart.payPanelLoading') %></div>
                <span class="err-hint" id="pay-panel-hint"></span>
              </div>
              <div id="pay-embed"></div>
            </div>
          </aside>
          <script nonce="<%= cspNonce %>">
          (function () {
            var form = document.getElementById('cart-pay-form');
            if (!form || !window.fetch) return;
            var panel = document.getElementById('pay-panel');
            var overlay = document.getElementById('pay-overlay');
            var status = document.getElementById('pay-panel-status');
            var spin = document.getElementById('pay-panel-spin');
            var msg = document.getElementById('pay-panel-msg');
            var hint = document.getElementById('pay-panel-hint');
            var embedHost = document.getElementById('pay-embed');
            var payBtn = form.querySelector('button[type="submit"]');
            var checkout = null;
            var stripeJsPromise = null;
            var I18N = {
              loading: <%- JSON.stringify(t('cart.payPanelLoading')) %>,
              error: <%- JSON.stringify(t('cart.payPanelError')) %>,
              errorHint: <%- JSON.stringify(t('cart.payPanelErrorHint')) %>
            };

            function loadStripeJs() {
              if (window.Stripe) return Promise.resolve();
              if (!stripeJsPromise) {
                stripeJsPromise = new Promise(function (resolve, reject) {
                  var s = document.createElement('script');
                  s.src = 'https://js.stripe.com/v3/';
                  s.onload = resolve;
                  s.onerror = function () { stripeJsPromise = null; reject(new Error('Stripe.js could not load')); };
                  document.head.appendChild(s);
                });
              }
              return stripeJsPromise;
            }

            function openPanel() {
              panel.hidden = false;
              status.hidden = false;
              status.classList.remove('error');
              spin.hidden = false;
              msg.textContent = I18N.loading;
              hint.textContent = '';
              requestAnimationFrame(function () { document.body.classList.add('pay-open'); });
            }

            function closePanel() {
              document.body.classList.remove('pay-open');
              if (checkout) { try { checkout.destroy(); } catch (e) {} checkout = null; }
              embedHost.innerHTML = '';
              payBtn.disabled = false;
              setTimeout(function () { panel.hidden = true; }, 300);
            }

            function showError(detail) {
              status.hidden = false;
              status.classList.add('error');
              spin.hidden = true;
              msg.textContent = detail || I18N.error;
              hint.textContent = I18N.errorHint;
            }

            form.addEventListener('submit', function (e) {
              e.preventDefault();
              if (payBtn.disabled) return;
              payBtn.disabled = true;
              openPanel();
              fetch(form.action, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                  'Accept': 'application/json',
                  'X-CSRF-Token': (form.querySelector('input[name="_csrf"]') || {}).value || ''
                }
              })
                .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
                .then(function (res) {
                  if (!res.ok || res.j.error) {
                    throw new Error((res.j && res.j.error ? res.j.error + (res.j.detail ? ' — ' + res.j.detail : '') : I18N.error));
                  }
                  if (res.j.url) { window.location.assign(res.j.url); return; }
                  return loadStripeJs().then(function () {
                    return window.Stripe(res.j.publishableKey).initEmbeddedCheckout({ clientSecret: res.j.clientSecret });
                  }).then(function (co) {
                    checkout = co;
                    status.hidden = true;
                    co.mount('#pay-embed');
                  });
                })
                .catch(function (err) { showError(err && err.message); });
            });

            document.getElementById('pay-panel-close').addEventListener('click', closePanel);
            overlay.addEventListener('click', closePanel);
            document.addEventListener('keydown', function (e) {
              if (e.key === 'Escape' && document.body.classList.contains('pay-open')) closePanel();
            });
          })();
          </script>
          <% } %>

          <% if (cart.quote.length) { %>
          <div class="cart-section">
            <h2><%= t('cart.sectionQuote') %></h2>
            <% cart.quote.forEach(function (l) { %>
            <div class="cart-line">
              <div class="l-main">
                <strong><%= l.name %></strong>
                <% if (l.quote_requested_at) { %> <span class="quote-flag"><%= t('cart.quoteRequested') %></span><% } %>
              </div>
              <form method="POST" action="/portal/cart/items/<%= l.product_id %>/remove">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn-mini danger" type="submit"><%= t('cart.remove') %></button>
              </form>
            </div>
            <% }); %>
            <form method="POST" action="/portal/cart/quote">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <textarea class="quote-note" name="note" maxlength="2000" placeholder="<%= t('cart.notePlaceholder') %>"></textarea>
              <div style="display:flex;gap:0.6rem;flex-wrap:wrap;align-items:center;">
                <button class="btn-quote" type="submit"><%= t('cart.requestQuote', { count: cart.quote.length }) %></button>
                <a class="btn-wa" href="<%= waQuoteLink %>" target="_blank" rel="noopener noreferrer">WhatsApp</a>
              </div>
            </form>
            <p class="hint"><%= t('cart.quoteHint') %></p>
          </div>
          <% } %>

        <% } %>
      </div>
    </main>
  </div>
  <%- include('partials/footer') %>
