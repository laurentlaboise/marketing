<%# Portal sidebar nav. Pass { active: 'dashboard'|'workspace'|... }.
    Icons come from the shared minimal set in partials/icon.ejs. %>
<aside class="sidebar" id="portal-sidebar" aria-label="<%= t('nav.menuLabel') %>">
  <div class="sidebar-group"><%= t('nav.groupWork') %></div>
  <a class="nav-item <%= active === 'dashboard' ? 'active' : '' %>" href="/portal/">
    <span class="ico"><%- include('icon', { name: 'home' }) %></span><%= t('nav.dashboard') %>
  </a>
  <a class="nav-item <%= active === 'workspace' ? 'active' : '' %>" href="/portal/workspace">
    <span class="ico"><%- include('icon', { name: 'briefcase' }) %></span><%= t('nav.workspace') %>
  </a>
  <% if (typeof featureCart !== 'undefined' && featureCart) { %>
  <a class="nav-item <%= active === 'cart' ? 'active' : '' %>" href="/portal/cart">
    <span class="ico"><%- include('icon', { name: 'cart' }) %></span><%= t('nav.cart') %>
    <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
    <span style="margin-left:auto;background:var(--wts-magenta,#d62b83);color:#fff;border-radius:999px;font-size:0.7rem;font-weight:800;padding:0.08rem 0.5rem;line-height:1.4;"><%= cartCount %></span>
    <% } %>
  </a>
  <% } %>
  <% if (typeof featureWhiteboard !== 'undefined' && featureWhiteboard) { %>
  <a class="nav-item <%= active === 'boards' ? 'active' : '' %>" href="/portal/boards">
    <span class="ico"><%- include('icon', { name: 'columns' }) %></span><%= t('nav.boards') %>
  </a>
  <% } %>
  <a class="nav-item <%= active === 'files' ? 'active' : '' %>" href="/portal/files">
    <span class="ico"><%- include('icon', { name: 'file' }) %></span><%= t('nav.files') %>
  </a>
  <a class="nav-item <%= active === 'chat' ? 'active' : '' %>" href="/portal/chat">
    <span class="ico"><%- include('icon', { name: 'spark' }) %></span><%= t('nav.chat') %>
  </a>

  <div class="sidebar-group"><%= t('nav.groupAccount') %></div>
  <a class="nav-item <%= active === 'billing' ? 'active' : '' %>" href="/portal/billing">
    <span class="ico"><%- include('icon', { name: 'card' }) %></span><%= t('nav.billing') %>
  </a>
  <a class="nav-item <%= active === 'programs' ? 'active' : '' %>" href="/portal/programs">
    <span class="ico"><%- include('icon', { name: 'users' }) %></span><%= t('nav.programs') %>
  </a>
  <a class="nav-item <%= active === 'profile' ? 'active' : '' %>" href="/portal/profile">
    <span class="ico"><%- include('icon', { name: 'user' }) %></span><%= t('nav.profile') %>
  </a>

  <p class="sidebar-foot"><%= t('nav.sidebarFoot') %></p>
</aside>
