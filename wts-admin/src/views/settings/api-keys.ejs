<%- include('../partials/head', { title, bodyClass: 'dashboard-layout' }) %>
<%- include('../partials/sidebar', { currentPage, user }) %>

<main class="main-content">
  <%- include('../partials/header', { user, messages }) %>

  <div class="page-content">
    <div class="page-header">
      <div>
        <h1 class="page-title">API Keys</h1>
        <p class="page-subtitle">Credentials for external tools (Make.com, n8n, partner sites) that connect to the automation API. Each integration gets its own key with its own permissions — revoke one without affecting the others.</p>
      </div>
    </div>

    <% if (error) { %>
    <div class="alert alert-error"><i class="fas fa-circle-exclamation"></i> <%= error %></div>
    <% } %>

    <% if (newKey) { %>
    <div class="card key-reveal-card">
      <div class="card-body">
        <h3 class="form-section-title key-reveal-title"><i class="fas fa-key"></i> Key created: <%= newKey.name %></h3>
        <p class="key-reveal-warning">Copy it now — this is the only time it will ever be shown. If you lose it, revoke it and create a new one.</p>
        <div class="key-reveal-row">
          <code id="new-key-value" class="key-reveal-value"><%= newKey.plaintext %></code>
          <button type="button" id="copy-key-btn" class="btn btn-primary"><i class="fas fa-copy"></i> Copy</button>
        </div>
        <p class="form-help">The integration sends it on every request as the <code>x-api-key</code> header.</p>
      </div>
    </div>
    <script nonce="<%= cspNonce %>">
      document.getElementById('copy-key-btn').addEventListener('click', function () {
        var text = document.getElementById('new-key-value').textContent;
        navigator.clipboard.writeText(text).then(() => {
          this.innerHTML = '<i class="fas fa-check"></i> Copied';
        }).catch(() => {
          var range = document.createRange();
          range.selectNodeContents(document.getElementById('new-key-value'));
          var sel = window.getSelection();
          sel.removeAllRanges(); sel.addRange(range);
        });
      });
    </script>
    <% } %>

    <div class="card form-card">
      <div class="card-body">
        <form action="/settings/api-keys/create" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-section">
            <h3 class="form-section-title"><i class="fas fa-plus"></i> Create a key</h3>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="key-name">Name *</label>
                <input type="text" id="key-name" name="name" class="form-input" placeholder="e.g. Make.com articles, partner-site CRM" required maxlength="255">
                <p class="form-help">Who or what is this key for? Shown in the list below so you can tell integrations apart.</p>
              </div>
              <div class="form-group">
                <label class="form-label" for="key-expires">Expires</label>
                <input type="date" id="key-expires" name="expires_at" class="form-input">
                <p class="form-help">Optional. Leave empty for a key that lasts until revoked.</p>
              </div>
            </div>
          </div>

          <div class="form-section">
            <h3 class="form-section-title"><i class="fas fa-shield-halved"></i> Permissions</h3>
            <p class="form-help scope-grid-help"><code>*</code> grants full access and <code>*:read</code> read-only access to everything; otherwise pick individual areas — <code>:read</code> variants allow reading but not changing.</p>
            <div class="scope-grid">
              <% allScopes.forEach(scope => { %>
              <div class="form-checkbox">
                <input type="checkbox" id="scope-<%= scope.replace(/[^a-z0-9-]/gi, '-') %>" name="scopes" value="<%= scope %>">
                <label for="scope-<%= scope.replace(/[^a-z0-9-]/gi, '-') %>"><code><%= scope %></code></label>
              </div>
              <% }); %>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-key"></i> Create key</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-body" style="padding: 0;">
        <% if (keys.length > 0) { %>
        <div class="table-container">
          <table class="table table-responsive-cards">
            <thead>
              <tr>
                <th>Name</th>
                <th>Key</th>
                <th>Permissions</th>
                <th>Status</th>
                <th>Last used</th>
                <th>Expires</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% keys.forEach(key => { %>
              <tr>
                <td data-label="Name"><strong><%= key.name %></strong></td>
                <td data-label="Key"><code><%= key.key_prefix %>…</code></td>
                <td data-label="Permissions" class="key-scopes-cell"><% (key.scopes || []).forEach(s => { %><code><%= s %></code><% }); %></td>
                <td data-label="Status">
                  <span class="status-badge <%= key.status === 'active' ? 'active' : 'inactive' %>">
                    <i class="fas <%= key.status === 'active' ? 'fa-circle-check' : 'fa-ban' %>"></i>&nbsp;<%= key.status %>
                  </span>
                </td>
                <td data-label="Last used"><%= key.last_used_at ? new Date(key.last_used_at).toLocaleString() : 'never' %></td>
                <td data-label="Expires"><%= key.expires_at ? new Date(key.expires_at).toLocaleDateString() : '—' %></td>
                <td data-label="Actions">
                  <div class="table-actions">
                    <form action="/settings/api-keys/<%= key.id %>/status" method="POST" style="display: inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <% if (key.status === 'active') { %>
                      <input type="hidden" name="status" value="revoked">
                      <button type="submit" class="btn btn-sm btn-secondary" title="Revoke"><i class="fas fa-ban"></i></button>
                      <% } else { %>
                      <input type="hidden" name="status" value="active">
                      <button type="submit" class="btn btn-sm btn-secondary" title="Reactivate"><i class="fas fa-rotate-left"></i></button>
                      <% } %>
                    </form>
                    <form action="/settings/api-keys/<%= key.id %>/delete" method="POST" style="display: inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-danger" title="Delete" data-confirm-delete><i class="fas fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i class="fas fa-key"></i></div>
          <h3>No API keys yet</h3>
          <p>Create the first one above — for example a Make.com key with <code>articles</code>, <code>images</code>, and <code>guides</code> permissions.</p>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
