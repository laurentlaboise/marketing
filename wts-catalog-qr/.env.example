# Public API root on wts-admin (no trailing slash).
# Products: GET $VITE_PORTAL_API/products and /products/:slug
VITE_PORTAL_API=https://admin.wordsthatsells.website/api/public

# Portal origin used for cart / chat / login handoff (no trailing slash).
VITE_PORTAL_ORIGIN=https://admin.wordsthatsells.website

# Set to 1 to skip the live API and always use catalog-seed.json.
VITE_DEMO=0

# Origin encoded into printed QR codes (no trailing slash).
# Defaults to window.location.origin when left empty.
VITE_PUBLIC_ORIGIN=

# WhatsApp digits only (Laos default matches wts-admin portal-cart).
VITE_WHATSAPP=8562055528034
